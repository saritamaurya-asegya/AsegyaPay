{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Auth": {
    "Authority": "https://auth.asegyapay.com",
    "Audience": "payment-service"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=asegyapay_payments;Username=postgres;Password=",
    "Redis": "localhost:6379"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000", "http://localhost:3001"]
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "GroupId": "payment-service"
  }
}
